{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@lesson/*": [
        "solutions/12-external-agent/*"
      ]
    }
  },
  "include": [
    "core-app",
    "exercises",
    "solutions",
    "scripts",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
