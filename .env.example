# Never prefix these with VITE_: the browser must not receive the API key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=zai-org/GLM-5.3-Flash
# Set to 1 for deterministic practice without paid model calls.
WORKSHOP_MOCK=0
PORT=3000

# lexical is a labeled offline fallback; semantic requires npm run prepare:retrieval
RETRIEVAL_MODE=lexical
